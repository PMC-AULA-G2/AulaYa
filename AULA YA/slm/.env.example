# Copy this file to .env and replace every placeholder before starting the API.
AULA_AUTH_SECRET=replace-with-at-least-32-random-characters
AULA_AUTH_DB=data/aula_auth.sqlite
AULA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SMTP account for sending six-digit account recovery codes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=AULA <no-reply@example.com>
SMTP_USE_SSL=false
